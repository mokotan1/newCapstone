# Play log pipeline — copy to tools/.env and fill values (never commit tools/.env)
#
# Windows: copy tools\.env.example tools\.env
# macOS/Linux: cp tools/.env.example tools/.env
#
# tools/.env is gitignored. Load before running the pipeline, e.g.:
#   PowerShell: Get-Content tools\.env | ForEach-Object { ... }  or set vars manually
#   bash: set -a && source tools/.env && set +a

# Path to Google Cloud service account JSON (see tools/secrets/google-service-account.example.json)
GOOGLE_APPLICATION_CREDENTIALS=tools/secrets/google-service-account.json

# Target Google Spreadsheet ID (/d/{THIS_ID}/ in the URL)
GOOGLE_SHEET_ID=

# Upload user_message / bot_response to RawLogs (true|false, default false)
INCLUDE_CHAT_TEXT=false
