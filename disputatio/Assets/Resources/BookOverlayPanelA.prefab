MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7fb37bbd8b4142158db1f14e3af6d8a2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titleText: {fileID: 510053}
  bodyText: {fileID: 510073}
  pageIndicatorText: {fileID: 510133}
  previousButton: {fileID: 510144}
  nextButton: {fileID: 510164}
  closeButton: {fileID: 510114}
  title: "\uCC22\uC5B4\uC9C4 \uCC45\uC758 \uBA54\uBAA8"
  fullText: "\uC789\uD06C\uAC00 \uBC88\uC9C4 \uBB38\uC7A5 \uC0AC\uC774\uB85C \uAC19\uC740
    \uC774\uB984\uC774 \uBC18\uBCF5\uB418\uC5B4 \uC788\uB2E4.\n\n\uB9C8\uC9C0\uB9C9
    \uC904\uB9CC \uC720\uB09C\uD788 \uC120\uBA85\uD558\uB2E4.\n\"\uBD88\uC744 \uB108\uBB34
    \uC624\uB798 \uB450\uC9C0 \uB9D0 \uAC83. \uADF8 \uB0C4\uC0C8\uB97C \uB9E1\uC740
    \uC0AC\uB78C\uC740 \uBC18\uB4DC\uC2DC \uB4A4\uB97C \uB3CC\uC544\uBCF8\uB2E4.\"\n\n\uD55C
    \uD398\uC774\uC9C0\uC5D0 \uB108\uBB34 \uB9CE\uC740 \uBB38\uC7A5\uC774 \uB4E4\uC5B4\uAC00\uBA74
    \uC77D\uAE30 \uD750\uB984\uC774 \uBB34\uB108\uC9C4\uB2E4. \uC774 \uD504\uB9AC\uD3A9\uC740
    Full Text\uC5D0 \uAE34 \uBCF8\uBB38\uC744 \uB123\uC73C\uBA74 Max Characters Per
    Page \uAE30\uC900\uC73C\uB85C \uC790\uB3D9 \uBD84\uD560\uD55C\uB2E4."
  maxCharactersPerPage: 110
  resetToFirstPageOnOpen: 1
