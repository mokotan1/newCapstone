{
  "schemaVersion": 1,
  "id": "kitchen.faucet-key",
  "scene": "Kitchen",
  "preset": "before-faucet",
  "steps": [
    {
      "id": "click-faucet",
      "command": "interaction.pointer",
      "target": "kitchen.sink.faucet",
      "timeoutMs": 5000
    },
    {
      "id": "assert-input-unlocked",
      "command": "state.assert",
      "timeoutMs": 5000,
      "assertion": {
        "kind": "inputUnlocked",
        "description": "Clicking the faucet must not leave the global input gate locked."
      }
    },
    {
      "id": "assert-no-console-errors",
      "command": "state.assert",
      "timeoutMs": 5000,
      "assertion": {
        "kind": "noNewConsoleError",
        "description": "The faucet Fungus block/interaction route must not log new console errors."
      }
    }
  ]
}
