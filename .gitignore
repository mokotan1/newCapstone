# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
# Local pytest basetemp (Windows TEMP permission workaround)
.tmp_pytest/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
# CI Roslyn syntax checker — not Unity-generated; must be tracked for GitHub Actions
!scripts/CSharpSyntaxChecker/**/*.csproj
scripts/CSharpSyntaxChecker/**/obj/
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
tools/.env
.venv/
.codex_tmp_runtime/
.codex_tmp_extracted/

# Play log Google Sheets credentials (never commit real service account keys)
tools/secrets/*.json
!tools/secrets/*.example.json
*-service-account.json
!*service-account.example.json

# Telemetry play-log CSVs collected on the server (never commit user play data)
backend_ai/logs/

# Deploy/rollback state written on the EC2 host (deploy.sh / rollback.sh)
backend_ai/.last_deployed_sha
backend_ai/.prev_deployed_sha

# Node dependencies generated for local tooling inside Unity assets
disputatio/Assets/**/node_modules/
disputatio/Assets/**/node_modules.meta

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Local / personal tooling (not project knowledge) ---
# Tracked: .cursor/skills/, .cursor/rules/, .cursorrules
.cursor/errors/
.cursor/mcp.json
.cursor/worktrees.json
.playwright-mcp/
.superpowers/

# Microsoft Office lock/temp files (e.g. ~$document.docx)
~$*
